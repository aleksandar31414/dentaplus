# Copy to .env for running without Docker (npm run dev)
PORT=3000
NODE_ENV=development

# Local database (used when NODE_ENV != production)
MONGODB_URI=mongodb://127.0.0.1:27017/dentaplus
# Production database (used automatically when NODE_ENV=production, e.g. on Render)
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dentaplus?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:3000
SEED_ON_START=false

# Time zone of the clinic (working hours)
TZ=Europe/Skopje

# E-mail (nodemailer). Leave SMTP_HOST empty -> e-mails are only logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DentaPlus <no-reply@dentaplus.mk>"
